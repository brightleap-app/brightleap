  {
    "id": "y56-sats-001",
    "module": "fractions",
    "topic": "sats_word_problems",
    "difficulty": 3,
    "question_type": "fill_in",
    "question_text": "A pizza is cut into 8 slices. Tom eats 3/8 and his sister eats 1/4. What fraction is left?",
    "correct_answer": "3/8",
    "accept_equivalent": true,
    "hint": "First convert 1/4 to eighths, then add the eaten parts.",
    "worked_solution_steps": [
      "Step 1: Convert 1/4 to eighths: 1/4 = 2/8.",
      "Step 2: Tom + sister = 3/8 + 2/8 = 5/8 eaten.",
      "Step 3: Left = 8/8 - 5/8 = 3/8.",
      "Step 4: 3/8 of the pizza is left. ✅"
    ],
    "analogy": "8 slices total. 5 eaten, 3 remain."
  },
  {
