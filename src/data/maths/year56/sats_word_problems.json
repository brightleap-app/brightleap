    "difficulty": 3,
    "question_type": "fill_in",
    "question_text": "A coat costs £60. It is reduced by 25% in a sale. What is the sale price?",
    "correct_answer": "£45",
    "accept_equivalent": true,
    "hint": "Find 25% of £60 and subtract from the original price.",
    "worked_solution_steps": [
      "Step 1: 25% of £60 = £60 ÷ 4 = £15.",
      "Step 2: Sale price = £60 - £15 = £45.",
      "Step 3: The sale price is £45. ✅"
    ],
    "analogy": "You save a quarter, so pay three quarters of £60."
