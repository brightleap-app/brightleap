    "topic": "sats_word_problems",
    "difficulty": 3,
    "question_type": "fill_in",
    "question_text": "A recipe uses 3/4 kg of flour. Sam wants to make half the recipe. How much flour does he need?",
    "correct_answer": "3/8 kg",
    "accept_equivalent": true,
    "hint": "Find half of 3/4.",
    "worked_solution_steps": [
      "Step 1: Half the recipe means half of 3/4 kg.",
      "Step 2: 3/4 ÷ 2 = 3/4 × 1/2 = 3/8.",
      "Step 3: Sam needs 3/8 kg of flour. ✅"
    ],
    "analogy": "Half of three quarters is three eighths."
  },
