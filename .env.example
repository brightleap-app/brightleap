# Brightleap environment variables
#
# Copy this file to `.env.local` and fill in the values below.
# `.env.local` is gitignored and must never be committed.
#
# Both values are Supabase's PUBLISHABLE credentials — they are safe to expose
# because they are protected by Row Level Security and already ship in the
# client bundle on the live site. Do NOT put any service_role key or other
# secret in this file.

# Your Supabase project URL, e.g. https://your-project.supabase.co
VITE_SUPABASE_URL=

# Your Supabase anon / publishable key
VITE_SUPABASE_ANON_KEY=
